# BOS Playbook - Environment Variables
# Copy to .env and replace values before deployment

# Supabase self-host (official images)
SUPABASE_VERSION=17.0.0
POSTGRES_VERSION=15.4
GOTRUE_VERSION=2.110.0
POSTGREST_VERSION=14.0.1
RESTIER_VERSION=1.0.0
REALTIME_VERSION=2.29.8
STORAGE_VERSION=2.36.1
IMGPROXY_VERSION=3.23.0
META_VERSION=2.27.0
EDGE_FUNCTIONS_VERSION=1.1.1
KONG_VERSION=3.6.1

# JWT and security
JWT_SECRET=change_this_to_a_secure_random_string
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlhdCI6MTYxMjM5OTAwMCwiZXhwIjoyMDAwMDAwMCJ9.some_verification_token
SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZSIsImlhdCI6MTYxMjM5OTAwMCwiZXhwIjoyMDAwMDAwMCJ9.some_verification_token

# Database
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_secure_password
PGDATA=/var/lib/postgresql/data

# GoTrue (Auth)
GOTRUE_API_HOST=http://localhost
GOTRUE_API_PORT=8000
GOTRUE_DB_DRIVER=postgres
GOTRUE_DB_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# PostgREST
POSTGREST_HOST=0.0.0.0
POSTGREST_PORT=3000
POSTGREST_DB_URI=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Realtime
REALTIME_HOST=0.0.0.0
REALTIME_PORT=8000

# Storage
STORAGE_HOST=0.0.0.0
STORAGE_PORT=8001

# ImgProxy
IMGPROXY_HOST=0.0.0.0
IMGPROXY_PORT=8002

# Meta
META_HOST=0.0.0.0
META_PORT=8003

# Edge Functions
EDGE_FUNCTIONS_HOST=0.0.0.0
EDGE_FUNCTIONS_PORT=8004

# Kong
KONG_HOST=0.0.0.0
KONG_PORT=8005

# Studio
STUDIO_HOST=0.0.0.0
STUDIO_PORT=3001

# Reverse Proxy (Nginx)
DOMAIN=playbook.local
HTTPS_CERT=/path/to/cert.pem
HTTPS_KEY=/path/to/key.pem

# Frontend
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_APP_NAME="BOS Playbook"
NEXT_PUBLIC_APP_LOGO=/logo.png
NEXT_PUBLIC_ACCENT_COLOR=#0066CC

# App Settings
APP_ENV=development
APP_PORT=3002
NODE_ENV=development

# Security
UPLOAD_MAX_SIZE=10485760  # 10MB
ALLOWED_UPLOAD_TYPES=image/*,application/pdf,text/plain,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# Session
SESSION_TIMEOUT=3600

# Rate Limiting
RATE_LIMIT_WINDOW=900
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# Backup
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_SCHEDULE="0 2 * * *"

# Monitoring
ENABLE_PROMETHEUS=false
PROMETHEUS_PORT=9090